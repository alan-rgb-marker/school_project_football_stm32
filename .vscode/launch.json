    "version": "0.2.0",
    "configurations": [

        {
            "cwd": "${workspaceFolder}",
            "executable": "./build/School_Football_Project.elf",
            "name": "Debug with ST-Link",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "servertype": "openocd",
            "device": "STM32F407xx",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "gdbPath": "gdb-multiarch"
            // "runToMain": true,
        }
    ]
}