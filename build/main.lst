 280:Core/Src/main.c ****   /* Infinite loop */
 281:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 282:Core/Src/main.c ****   while (1)
 283:Core/Src/main.c ****   {
 284:Core/Src/main.c **** 
 285:Core/Src/main.c ****     if (if_start == true)
 286:Core/Src/main.c ****     {
 287:Core/Src/main.c ****       if (HAL_GetTick() - start_time >= 20)
 288:Core/Src/main.c ****       {
 289:Core/Src/main.c **** 
 290:Core/Src/main.c ****         Step_motor *select_step_motor = which_step_motor(&ball_coord, &one, &two, &three);
 291:Core/Src/main.c ****         float *man_range;
 292:Core/Src/main.c ****         if (select_step_motor != NULL)
 293:Core/Src/main.c ****         {
 294:Core/Src/main.c ****           man_range = which_man_range(&ball_coord, select_step_motor);
 295:Core/Src/main.c ****         }
 296:Core/Src/main.c ****         if (select_step_motor != NULL && man_range != NULL)
 297:Core/Src/main.c ****         {
 298:Core/Src/main.c ****           result = ball_coord.y - *man_range;
 299:Core/Src/main.c ****           /* ---------------- pid ----------------- */
 300:Core/Src/main.c ****           freq = PI_Update(&pid, result);
 301:Core/Src/main.c ****           Set_Step_Frequency(select_step_motor, fabs(freq));
 302:Core/Src/main.c ****           /* ---------------- pid ----------------- */
 303:Core/Src/main.c **** 
 304:Core/Src/main.c ****           // 判斷方向
 305:Core/Src/main.c ****           if (result > 2)
 306:Core/Src/main.c ****           {
 307:Core/Src/main.c ****             dir_and_move_step_motor(select_step_motor, 1);
 308:Core/Src/main.c ****           }
 309:Core/Src/main.c ****           else if (result < -2)
 310:Core/Src/main.c ****           {
 311:Core/Src/main.c ****             dir_and_move_step_motor(select_step_motor, -1);
 312:Core/Src/main.c ****           }
 313:Core/Src/main.c ****           else
 314:Core/Src/main.c ****           {
 315:Core/Src/main.c ****             stop_step_motor(select_step_motor);
 316:Core/Src/main.c ****           }
ARM GAS  /tmp/ccrHHC5A.s 			page 7


 317:Core/Src/main.c **** 
 318:Core/Src/main.c ****           if (fabs(result) <= 2) // 判斷距離
